# GEMINI_API_KEY: Primary free-tier Google AI Studio API key (server-side only).
# AI Studio automatically injects this at runtime from Settings -> Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional secondary/tertiary free-tier keys for seamless failover under 429/503 traffic
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
